# Copy this to .env.local for local development, or set the same names in Vercel Project Settings.
# Never put this key in index.html, app.js, or any browser-visible file.
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# China mainland endpoint:
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# International/Singapore endpoint, use this instead if your key is from the international console:
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

QWEN_MODEL=qwen-plus

# Supabase. The anon key is safe for browser use when RLS is enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
